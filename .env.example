# ==============================================================================
# SkoolSys 2.0 — Environment Configuration Template (Root)
# ==============================================================================
# Copy this file to .env or configure in your deployment orchestration.
# NEVER commit real secret keys or production passwords to version control.
# ==============================================================================

# Backend API Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Relative to server directory or absolute path)
# Default for development: ./skoolsys.db
DB_PATH=./skoolsys.db

# Authentication Security
# Generate a cryptographically strong secret in production:
# openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173
