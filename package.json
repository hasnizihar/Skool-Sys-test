{
  "name": "skoolsys",
  "version": "1.0.0",
  "description": "SkoolSys - School Management System (Grades 6–13) MVP",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test",
    "test:browser": "npm --prefix server run test:browser",
    "test:browser:attendance": "npm --prefix server run test:browser:attendance",
    "test:browser:exam": "npm --prefix server run test:browser:exam",
    "test:all": "npm --prefix server run test:all",
    "typecheck": "npm --prefix server run typecheck",
    "lint": "npm --prefix client run lint",
    "build": "npm run build:server && npm run build:client",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
