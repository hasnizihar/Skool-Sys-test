# ==============================================================================
# SkoolSys 2.0 Backend Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development
DB_PATH=./skoolsys.db

# MANDATORY SECURITY SETTING:
# Must be configured with high entropy in staging and production.
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
